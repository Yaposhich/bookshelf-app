{
  "name": "bookshelf-app",
  "version": "1.4.0",
  "description": "Особиста бібліотека книг",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "electron .",
    "start": "concurrently \"vite\" \"electron .\"",
    "postinstall": "electron-builder install-app-deps",
    "dist": "vite build && electron-builder --config electron-builder.config.js",
    "release": "vite build && electron-builder --config electron-builder.config.js --publish always"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
